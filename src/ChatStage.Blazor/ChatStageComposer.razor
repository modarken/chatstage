@namespace ChatStage
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @attributes="Attributes" class="@($"chatstage-composer {Class}".TrimEnd())" style="@Style" data-busy="@(Context.IsBusy ? "true" : "false")">
    <textarea @ref="_input" class="chatstage-input" value="@Context.InputText" @oninput="InputChangedAsync"
              placeholder="@Placeholder" aria-label="@InputLabel" rows="@Rows" @onfocus="Focused" @onblur="Blurred"></textarea>
    @if (Context.IsBusy)
    {
        <button type="button" class="chatstage-stop" @onclick="Context.Stop">@StopText</button>
    }
    else
    {
        <button type="button" class="chatstage-send" @onclick="SendAsync">@SendText</button>
    }
</div>

@code {
    private ElementReference _input;
    private IJSObjectReference? _module;
    private IJSObjectReference? _keyboard;
    private bool? _keyboardSubmitOnEnter;
    private DotNetObjectReference<ChatStageComposer>? _reference;
    private ChatStageSessionContext? _attached;
    private string? _lastInputText;

    /// <summary>The owning context, cascaded by <c>ChatStageSession</c> or <c>ChatStageChat</c>.</summary>
    /// <remarks>To own a slash-command popup, attachments or other controls, replace this component with your own.</remarks>
    [CascadingParameter] public ChatStageSessionContext Context { get; set; } = default!;

    /// <summary>The draft, for <c>@bind-InputText</c>; the context's <see cref="ChatStageSessionContext.InputText"/> holds it.</summary>
    [Parameter] public string? InputText { get; set; }

    /// <summary>Raised when the draft changes: on each edit, and when a send clears it.</summary>
    [Parameter] public EventCallback<string> InputTextChanged { get; set; }

    /// <summary>Whether Enter alone sends (Shift+Enter always inserts a newline). Default true.</summary>
    [Parameter] public bool SubmitOnEnter { get; set; } = true;

    /// <summary>The textarea's placeholder.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>The textarea's accessible label. Default "Message".</summary>
    [Parameter] public string InputLabel { get; set; } = "Message";

    /// <summary>The textarea's rows. Default 1.</summary>
    [Parameter] public int Rows { get; set; } = 1;

    /// <summary>The send button's text. Default "Send".</summary>
    [Parameter] public string SendText { get; set; } = "Send";

    /// <summary>The stop button's text, shown in place of send while a reply is in progress. Default "Stop".</summary>
    [Parameter] public string StopText { get; set; } = "Stop";

    /// <summary>Raised when the textarea gets the focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> Focused { get; set; }

    /// <summary>Raised when the textarea loses the focus.</summary>
    [Parameter] public EventCallback<FocusEventArgs> Blurred { get; set; }

    /// <summary>Extra CSS classes for the root element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style for the root element.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Any other attributes, applied to the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_attached, Context))
        {
            Detach();
            _attached = Context;
            Context.FocusInput = FocusInputAsync;
            Context.MessageSent += OnSent;
        }

        if (InputText is not null && InputText != _lastInputText)
        {
            _lastInputText = InputText;
            Context.InputText = InputText;
        }
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The textarea stays for the composer's lifetime, so its keyboard handler is attached once (again only when
        // SubmitOnEnter changes), not on every render.
        if (_keyboardSubmitOnEnter == SubmitOnEnter)
        {
            return;
        }

        try
        {
            if (_keyboard is not null)
            {
                await _keyboard.InvokeVoidAsync("dispose");
                await _keyboard.DisposeAsync();
                _keyboard = null;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ChatStage.Blazor/chatstage.js");
            _reference ??= DotNetObjectReference.Create(this);
            _keyboard = _module is null ? null : await _module.InvokeAsync<IJSObjectReference>("keyboard", _input, _reference, SubmitOnEnter);
            _keyboardSubmitOnEnter = SubmitOnEnter;
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; there is nothing to attach to.
        }
    }

    private async Task InputChangedAsync(ChangeEventArgs args)
    {
        Context.InputText = args.Value?.ToString() ?? string.Empty;
        _lastInputText = Context.InputText;
        await InputTextChanged.InvokeAsync(Context.InputText);
    }

    private void OnSent(ChatStageSubmission submission) => _ = InvokeAsync(async () =>
    {
        _lastInputText = Context.InputText;
        await InputTextChanged.InvokeAsync(Context.InputText);
        StateHasChanged();
    });

    /// <summary>Sends the draft through <see cref="ChatStageSessionContext.SubmitAsync"/>. Enter calls it too.</summary>
    [JSInvokable]
    public Task SendAsync() => Context.SubmitAsync();

    /// <summary>Raises the context's <see cref="ChatStageSessionContext.Escape"/>; it does not stop a reply.</summary>
    [JSInvokable]
    public void Escape() => Context.NotifyEscape();

    /// <summary>Focuses the textarea.</summary>
    public ValueTask FocusInputAsync() => _input.FocusAsync();

    private void Detach()
    {
        if (_attached is not null)
        {
            if (_attached.FocusInput == FocusInputAsync)
            {
                _attached.FocusInput = null;
            }

            _attached.MessageSent -= OnSent;
            _attached = null;
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        Detach();
        try
        {
            if (_keyboard is not null)
            {
                await _keyboard.InvokeVoidAsync("dispose");
                await _keyboard.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit has already released its browser resources.
        }

        _reference?.Dispose();
    }
}
