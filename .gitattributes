# Normalise line endings in the repository; check out with the platform's native endings.
* text=auto

# Files whose line endings matter to their tools.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
*.ico binary
*.snk binary
